<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <!-- Android supports these device-protected domains, but AGP 8.3 lint's
         domain list is outdated: developer.android.com/identity/data/autobackup. -->
    <exclude domain="device_root" path="." tools:ignore="FullBackupContent" />
    <exclude domain="device_file" path="." tools:ignore="FullBackupContent" />
    <exclude domain="device_database" path="." tools:ignore="FullBackupContent" />
    <exclude domain="device_sharedpref" path="." tools:ignore="FullBackupContent" />
</full-backup-content>
